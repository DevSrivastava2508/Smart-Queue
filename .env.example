# SmartQueue Environment Configuration

# Server Port (default 8080)
PORT=8080

# AI Chat API Keys (The server rotates from OpenRouter to Google Gemini as a failover)
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Google Apps Script Web App URL (for email notification dispatch & sheet logging)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwwnkhRldThKqxHIpsB1iOB2YaHSLC9A1JKwh0yGlx9p-YRJJAKLLcWSO0jluXcWitI/exec
