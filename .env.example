# Twilio SMS Automated Reminders Configuration
# Get your Account SID and Auth Token at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+17372508034
DEFAULT_SMS_RECIPIENT=+917428129916
